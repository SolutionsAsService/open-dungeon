# Copy to .env. Never commit real values.
# HTTP + WebSocket server port
PORT=8787
# Postgres connection string. Leave empty to use embedded PGlite at DATA_DIR/db
DATABASE_URL=
# Where PGlite data and uploaded files live when no external services are configured
DATA_DIR=.data
# Secret used to sign session cookies. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me
# Max upload size in bytes (default 20 MB)
MAX_UPLOAD_BYTES=20971520
