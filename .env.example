# Copy to .env (or export in your shell / process manager). Never commit real values.
# HTTP + WebSocket server port
PORT=8787
# PostgreSQL connection string. Leave empty to use embedded PGlite at DATA_DIR/db
DATABASE_URL=
# Where PGlite data and uploaded files live
DATA_DIR=.data
# Max upload size in bytes (default 20 MB)
MAX_UPLOAD_BYTES=20971520
# Set to 1 behind HTTPS so the session cookie is marked Secure
COOKIE_SECURE=
